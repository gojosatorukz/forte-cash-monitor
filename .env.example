# Generate the real, untracked .env with: python scripts/init_env.py
FCM_API_KEY=replace-with-a-random-local-secret
FCM_STORAGE_DIR=.runtime
FCM_MAX_UPLOAD_MB=64
FCM_MAX_ACTIVE_JOBS=4
FCM_JOB_BUDGET_SEC=270
# Empty until the ML teammate implements a local factory.
# Example later: FCM_ANALYZER_FACTORY=inference.local:create_analyzer
FCM_ANALYZER_FACTORY=
FCM_DATASET_DIR=../open/videos
FCM_MODELS_DIR=models
HF_HUB_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
