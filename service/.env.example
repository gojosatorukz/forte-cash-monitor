# Copy to .env (git-ignored); run.sh loads it. Variables already set in the shell take precedence.
API_KEY=change-me
# Web UI password: at least 12 characters, shared only within the team. The placeholder below (or anything
# shorter) counts as unset -> the UI answers 503, /api/v1 still works. Changing it logs everyone out.
UI_PASSWORD=change-me
# Cookie signing key; empty -> generated once into $DATA_DIR/ui_secret (mode 0600)
# UI_SECRET=
# UI_SESSION_HOURS=12
# Proxies whose X-Forwarded-For (rightmost entry) / X-Forwarded-Proto are trusted. Default: loopback
# (bare-metal); docker-compose.yml defaults to loopback + its gateway 172.30.57.1 + caddy 172.30.57.10.
# NetBird variant: add the team server's NetBird IP, e.g. 127.0.0.1/32,::1/128,172.30.57.1/32,100.x.y.z/32
# TRUSTED_PROXIES=127.0.0.1/32,::1/128
# Bare-metal listen address (default 127.0.0.1; the relay uses localhost). LAN demo / NetBird: 0.0.0.0
# HOST=127.0.0.1
# PORT=8000
# Docker only: host address the port is published on (default loopback; Docker bypasses ufw). LAN demo: 0.0.0.0
# BIND_ADDR=127.0.0.1
# DATA_DIR=./data
# JOB_TIMEOUT_SEC=270
# JOB_HARD_CAP_SEC=280
# MAX_UPLOAD_MB=200
# ANALYZER=app.analyzers.stub:StubAnalyzer
# STUB_DEBUG=0
# Rules file (README, "Справочник правил"). In Docker mount it and use the container path, e.g. /rules/rules.json
# RULES_PATH=../detector/taxonomy/rules.json
# Public URL (see README, "Публичный адрес"): relay via the team server (primary), Caddy (A) or Funnel (B).
# After changing .env with Docker: docker compose up -d   (restart does not re-read .env)
PUBLIC_HOSTNAME=forte.incode.kz
# Quick tunnel (C) only: where scripts/public_url.sh writes the URL (default $DATA_DIR/public_url.txt).
# PUBLIC_URL_FILE=./data/public_url.txt
